{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Site: serve",
      "type": "shell",
      "command": "hugo server -D --disableFastRender",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "CV: build all",
      "type": "shell",
      "command": "cd cv && ./build.sh"
    },
    {
      "label": "Build everything",
      "type": "shell",
      "command": "make build",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}